{{> rbl-shell-start}}
<h2 style="margin:0 0 18px;font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#0a0a0a;">Commande livrée</h2>
<p style="margin:0 0 16px;color:#3d3d3d;">Bonjour {{customerName}},</p>
<p style="margin:0 0 20px;color:#3d3d3d;">Votre commande <strong style="color:#0a0a0a;">#{{orderId}}</strong> a été livrée. Nous espérons qu’elle vous plaît.</p>
<div style="text-align:center;margin:28px 0 12px 0;">
  <a href="{{orderUrl}}" style="display:inline-block;background:#1a1a1a;color:#ffffff;padding:14px 28px;text-decoration:none;text-transform:uppercase;font-size:11px;font-weight:600;letter-spacing:0.14em;border:1px solid #1a1a1a;margin:0 6px 8px 6px;">Voir ma commande</a>
  <a href="{{frontendUrl}}" style="display:inline-block;background:#ffffff;color:#1a1a1a;padding:14px 28px;text-decoration:none;text-transform:uppercase;font-size:11px;font-weight:600;letter-spacing:0.14em;border:1px solid #1a1a1a;margin:0 6px 8px 6px;">Continuer mes achats</a>
</div>
{{> rbl-shell-end}}
