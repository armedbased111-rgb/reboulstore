    <td align="center" style="padding:28px 14px;">
      <table role="presentation" width="600" cellpadding="0" cellspacing="0" style="max-width:600px;width:100%;border-collapse:collapse;background:#ffffff;border:1px solid #dcdcdc;">
        <tr>
          <td style="background:#0a0a0a;padding:0;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="padding:26px 26px 22px 26px;">
                  <table role="presentation" cellpadding="0" cellspacing="0" align="left">
                    <tr>
                      <td style="padding-right:18px;vertical-align:middle;line-height:0;font-size:0;">
                        <img src="{{emailLogoUrl}}" alt="Reboul Store" style="display:block;border:0;outline:none;text-decoration:none;height:48px;width:auto;max-width:200px;-ms-interpolation-mode:bicubic;" />
                      </td>
                      <td style="width:1px;background-color:rgba(255,255,255,0.14);padding:0;font-size:0;line-height:0;" width="1">&nbsp;</td>
                      <td style="padding-left:18px;vertical-align:middle;">
                        <span style="display:block;font-family:'Geist',-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;font-size:19px;font-weight:700;letter-spacing:0.06em;color:#ffffff;text-transform:uppercase;line-height:1.12;">Reboul Store</span>
                        <span style="display:block;margin-top:7px;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:9px;letter-spacing:0.26em;color:rgba(255,255,255,0.42);text-transform:uppercase;">Concept store</span>
                      </td>
                    </tr>
                  </table>
                </td>
              </tr>
              <tr>
                <td style="height:3px;line-height:3px;font-size:0;background-color:#d93434;padding:0;">&nbsp;</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:0;background:#f4f4f4;border-bottom:1px solid #e4e4e4;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0">
              <tr>
                <td style="padding:12px 24px;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:8px;letter-spacing:0.22em;color:#7a7a7a;text-transform:uppercase;vertical-align:middle;">{{datum}}</td>
                <td align="right" style="padding:12px 24px;vertical-align:middle;">
                  <table role="presentation" cellpadding="0" cellspacing="0" align="right"><tr>
                    <td style="width:20px;height:1px;background:#c0c0c0;font-size:0;line-height:0;">&nbsp;</td>
                    <td style="width:6px;font-size:0;">&nbsp;</td>
                    <td style="width:4px;height:4px;background:#a8a8a8;font-size:0;line-height:0;">&nbsp;</td>
                    <td style="width:6px;font-size:0;">&nbsp;</td>
                    <td style="width:20px;height:1px;background:#c0c0c0;font-size:0;line-height:0;">&nbsp;</td>
                  </tr></table>
                </td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:0 22px 6px 22px;background:#ffffff;">
            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin-top:14px;">
              <tr>
                <td width="15" height="15" style="border-left:1px solid #bcbcbc;border-top:1px solid #bcbcbc;font-family:'Geist Mono',monospace;font-size:10px;line-height:13px;color:#b0b0b0;vertical-align:top;text-align:left;">+</td>
                <td style="border-top:1px solid #e6e6e6;font-size:0;line-height:0;">&nbsp;</td>
                <td width="15" height="15" align="right" style="border-right:1px solid #bcbcbc;border-top:1px solid #bcbcbc;font-family:'Geist Mono',monospace;font-size:10px;line-height:13px;color:#b0b0b0;vertical-align:top;">+</td>
              </tr>
            </table>
          </td>
        </tr>
        <tr>
          <td style="padding:10px 28px 30px 28px;font-family:'Geist',-apple-system,BlinkMacSystemFont,Helvetica,Arial,sans-serif;font-size:15px;line-height:1.58;color:#1a1a1a;">
