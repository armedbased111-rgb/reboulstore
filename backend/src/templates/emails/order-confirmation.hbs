{{> rbl-shell-start}}
<h2 style="margin:0 0 18px;font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#0a0a0a;">Confirmation de commande</h2>
<p style="margin:0 0 16px;color:#3d3d3d;">Bonjour {{customerName}},</p>
<p style="margin:0 0 16px;color:#3d3d3d;">Commande <strong style="color:#0a0a0a;">#{{orderId}}</strong> du {{orderDate}}.</p>
<div style="margin:20px 0;padding:18px 20px;background:#f8f8f8;border-left:2px solid #d93434;">
  <p style="margin:0 0 8px;color:#1a1a1a;"><strong>Montant total</strong> · {{total}} €</p>
  <p style="margin:0;font-family:'Geist Mono',monospace;font-size:12px;color:#5a5a5a;"><strong>Statut</strong> · {{status}}</p>
</div>
<p style="margin:0 0 20px;color:#5a5a5a;font-size:14px;">Merci pour votre achat. Vous serez informé de chaque étape.</p>
<div style="text-align:center;margin:28px 0 8px 0;">
  <a href="{{orderUrl}}" style="display:inline-block;background:#1a1a1a;color:#ffffff;padding:14px 32px;text-decoration:none;text-transform:uppercase;font-size:11px;font-weight:600;letter-spacing:0.16em;border:1px solid #1a1a1a;">Voir ma commande</a>
</div>
{{> rbl-shell-end}}
