{{> rbl-shell-start}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px 0;">
  <tr>
    <td style="width:3px;background:#d93434;font-size:0;line-height:0;">&nbsp;</td>
    <td style="padding-left:16px;">
      <p style="margin:0;font-family:'Geist Mono',monospace;font-size:8px;letter-spacing:0.2em;color:#8a8a8a;text-transform:uppercase;">Newsletter</p>
      <h2 style="margin:6px 0 0;font-size:14px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;line-height:1.25;">Merci pour votre inscription</h2>
    </td>
  </tr>
</table>
<p style="margin:0 0 16px;color:#3d3d3d;">Vous recevrez nos actualités sur <strong style="color:#0a0a0a;">{{email}}</strong> : dépôts, saisons (SS / AW), actus boutique et événements — sans sur-sollicitation.</p>
<div style="margin:24px 0;padding:18px 20px;background:#f8f8f8;border-left:2px solid #1a1a1a;">
  <p style="margin:0;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:10px;letter-spacing:0.08em;color:#6b6b6b;text-transform:uppercase;line-height:1.5;">Canal confirmé · opt-in newsletter · Reboul Store</p>
</div>
<div style="text-align:center;margin:28px 0 8px 0;">
  <a href="{{frontendUrl}}" style="display:inline-block;background:#1a1a1a;color:#ffffff;padding:14px 32px;text-decoration:none;text-transform:uppercase;font-size:11px;font-weight:600;letter-spacing:0.16em;border:1px solid #1a1a1a;">Visiter le site</a>
</div>
<p style="margin:20px 0 0;font-size:12px;color:#8a8a8a;line-height:1.5;">Une question ? Répondez à cet e-mail ou passez en boutique.</p>
{{> rbl-shell-end}}
