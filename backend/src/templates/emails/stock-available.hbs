{{> rbl-shell-start}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 22px 0;">
  <tr>
    <td style="width:3px;background:#d93434;font-size:0;line-height:0;padding:0;">&nbsp;</td>
    <td style="padding-left:16px;">
      <p style="margin:0;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:8px;letter-spacing:0.2em;color:#8a8a8a;text-transform:uppercase;">Alerte stock</p>
      <h2 style="margin:6px 0 0;font-size:14px;font-weight:700;letter-spacing:0.12em;text-transform:uppercase;color:#0a0a0a;line-height:1.25;">De nouveau disponible</h2>
    </td>
  </tr>
</table>
<p style="margin:0 0 14px;color:#3d3d3d;">Bonjour,</p>
<p style="margin:0 0 22px;color:#3d3d3d;">Le produit que vous suiviez est de retour en stock.</p>
{{#if productImageUrl}}
<div style="text-align:center;margin:0 0 22px 0;padding:12px;background:#fafafa;border:1px solid #ebebeb;">
  <img src="{{productImageUrl}}" alt="{{productName}}" width="520" style="max-width:100%;height:auto;display:block;margin:0 auto;border:1px solid #e0e0e0;" />
</div>
{{/if}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="margin:0 0 20px 0;background:#f8f8f8;border:1px solid #eaeaea;border-left:2px solid #1a1a1a;">
  <tr>
    <td style="padding:18px 20px;">
      <p style="margin:0 0 4px;font-family:'Geist Mono',monospace;font-size:9px;letter-spacing:0.14em;color:#7a7a7a;text-transform:uppercase;">Article</p>
      <p style="margin:0 0 10px;font-size:18px;font-weight:600;color:#0a0a0a;letter-spacing:-0.02em;line-height:1.3;">{{productName}}</p>
      {{#if variant}}
      <p style="margin:0;font-family:'Geist Mono',monospace;font-size:10px;letter-spacing:0.1em;color:#5a5a5a;text-transform:uppercase;">Variante · {{variant}}</p>
      {{/if}}
    </td>
  </tr>
</table>
<p style="margin:0 0 22px;color:#5a5a5a;font-size:14px;line-height:1.5;">Stocks limités — ne tardez pas.</p>
<div style="text-align:center;margin:30px 0 10px 0;">
  <a href="{{productUrl}}" style="display:inline-block;background:#1a1a1a;color:#ffffff;padding:16px 36px;text-decoration:none;text-transform:uppercase;font-size:11px;font-weight:600;letter-spacing:0.18em;border:1px solid #1a1a1a;">Voir le produit</a>
</div>
<p style="margin:22px 0 0;padding-top:18px;border-top:1px solid #eeeeee;font-size:10px;color:#9a9a9a;line-height:1.55;font-family:'Geist Mono',monospace;letter-spacing:0.04em;">Vous recevez cet e-mail car vous êtes inscrit aux alertes de disponibilité pour cet article.</p>
{{> rbl-shell-end}}
