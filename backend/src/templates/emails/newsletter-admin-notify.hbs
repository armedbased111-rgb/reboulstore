{{> rbl-shell-start}}
<h2 style="margin:0 0 18px;font-size:13px;font-weight:600;letter-spacing:0.14em;text-transform:uppercase;color:#0a0a0a;">Nouvelle inscription newsletter</h2>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="border-collapse:collapse;font-size:14px;margin:8px 0 20px 0;">
  <tr>
    <td style="padding:8px 14px 8px 0;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:9px;letter-spacing:0.12em;color:#8a8a8a;text-transform:uppercase;vertical-align:top;width:120px;">E-mail</td>
    <td style="padding:8px 0;vertical-align:top;color:#1a1a1a;font-weight:500;">{{email}}</td>
  </tr>
  <tr>
    <td style="padding:8px 14px 8px 0;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:9px;letter-spacing:0.12em;color:#8a8a8a;text-transform:uppercase;vertical-align:top;">Source</td>
    <td style="padding:8px 0;vertical-align:top;color:#3d3d3d;">{{source}}</td>
  </tr>
  <tr>
    <td style="padding:8px 14px 8px 0;font-family:'Geist Mono','SF Mono',Consolas,monospace;font-size:9px;letter-spacing:0.12em;color:#8a8a8a;text-transform:uppercase;vertical-align:top;">Date (UTC)</td>
    <td style="padding:8px 0;vertical-align:top;color:#3d3d3d;font-family:'Geist Mono',monospace;font-size:12px;">{{subscribedAt}}</td>
  </tr>
</table>
<p style="margin:0;font-size:11px;color:#9a9a9a;font-family:'Geist Mono',monospace;">Notification interne — ne pas transférer.</p>
{{> rbl-shell-end}}
