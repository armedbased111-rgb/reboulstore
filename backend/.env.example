# Serveur
PORT=3001
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=reboulstore_db

# JWT Authentication
JWT_SECRET=your-secret-key-change-in-production

# URL publique du site boutique (CORS, liens e-mail dont logo /favicon.svg, Stripe, SMS)
# Dev : http://localhost:3000
# Prod : obligatoirement https://… (domaine réel), jamais localhost — sinon images des mails invisibles
FRONTEND_URL=http://localhost:3000

# === PHASES FUTURES ===

# Cloudinary (Phase 15)
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Stripe (Phase 13)
# STRIPE_SECRET_KEY=
# STRIPE_PUBLIC_KEY=

# Email (Phase 11)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# Logo des e-mails (PNG/HTTPS) — défaut : même asset Cloudinary que le site ; Gmail n’affiche pas les SVG distants
# EMAIL_LOGO_URL=https://res.cloudinary.com/.../logo.png
# (alerte « nouvelle inscription newsletter » → même adresse que SMTP_USER)

# SMS (Phase 18)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
