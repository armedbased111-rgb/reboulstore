# ============================================
# Variables d'environnement PRODUCTION — Reboul Store
# ============================================
#
# 1. cp env.production.example .env.production
# 2. Remplir toutes les valeurs (secrets forts, jamais les mêmes qu’en dev)
# 3. Ne jamais commiter .env.production (gitignore)
#
# Déploiement Docker : préférer
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d
# pour que l’interpolation ${VAR} du compose lise bien ce fichier.
#
# ============================================

# ============================================
# BASE DE DONNÉES PostgreSQL
# ============================================
# Hôte joignable depuis le container backend (ex. service Docker, IP VPS, localhost si DB sur l’hôte)
DB_HOST=reboulstore-postgres-prod
DB_PORT=5432
DB_USERNAME=reboulstore
DB_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT
DB_DATABASE=reboulstore_db

# ============================================
# BACKEND — JWT
# ============================================
JWT_SECRET=CHANGEZ_MOI_SECRET_JWT_TRES_LONG_ET_ALEATOIRE

# ============================================
# STRIPE
# ============================================
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY_HERE
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET_HERE

# ============================================
# CLOUDINARY
# ============================================
CLOUDINARY_CLOUD_NAME=ton-cloud-name
CLOUDINARY_API_KEY=ton-api-key
CLOUDINARY_API_SECRET=ton-api-secret

# ============================================
# URL PUBLIQUE BOUTIQUE (obligatoire en prod)
# ============================================
# HTTPS + domaine canonique (www ou non : le même que dans le navigateur).
# Sert aux : CORS, liens dans les e-mails, redirections Stripe, SMS.
# Jamais http://localhost en production (warnings au démarrage + liens cassés).
FRONTEND_URL=https://reboulstore.com
VITE_API_URL=https://reboulstore.com/api

# ============================================
# E-MAIL TRANSACTIONNEL (Nest Mailer)
# ============================================
# Sans ces variables : pas d’envoi (commandes, inscription, newsletter, stock…).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton-compte-expediteur@example.com
SMTP_PASSWORD=mot_de_passe_application_ou_secret

# Optionnel — URL d’une image PNG/JPG pour l’en-tête des e-mails.
# Si absent : défaut code = logo Cloudinary (c_scale,h_96, ratio conservé).
# Ne pas utiliser de SVG distant (Gmail ne l’affiche pas).
# EMAIL_LOGO_URL=https://res.cloudinary.com/TON_CLOUD/image/upload/c_scale,h_96,q_auto:best,f_png/vVERSION/logo.png

# ============================================
# NODE
# ============================================
NODE_ENV=production

# ============================================
# ADMIN CENTRAL (si même fichier utilisé pour compose racine)
# ============================================
REBOUL_DB_USER=reboulstore
REBOUL_DB_PASSWORD=CHANGEZ_MOI_MOT_DE_PASSE_FORT
REBOUL_DB_NAME=reboulstore_db

# ============================================
# RAPPELS
# ============================================
# - Secrets : openssl rand -base64 32
# - Après premier déploiement newsletter : exécuter la migration TypeORM
#   newsletter_subscriptions (voir backend/src/migrations/*AddNewsletterSubscriptions*)
#   après backup DB.
# - Vérifier health : https://<domaine>/api ou port backend selon nginx
